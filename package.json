{
  "name": "openmicro",
  "version": "1.4.3",
  "description": "OpenMicro-based engine bundled with the native Xbox Micro macOS Agent controller app.",
  "license": "MIT",
  "author": "Stephen Leo (OpenMicro) and Xbox Micro contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kam74515-boop/xbox-micro.git"
  },
  "homepage": "https://github.com/kam74515-boop/xbox-micro#readme",
  "bugs": {
    "url": "https://github.com/kam74515-boop/xbox-micro/issues"
  },
  "x-upstream": {
    "name": "OpenMicro",
    "repository": "https://github.com/stephenleo/OpenMicro",
    "tag": "v1.4.3",
    "commit": "fcde3a1",
    "license": "MIT"
  },
  "type": "module",
  "bin": {
    "openmicro": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    },
    "./harness": {
      "types": "./dist/harness/index.d.ts",
      "default": "./dist/harness/index.js"
    },
    "./controller": {
      "types": "./dist/controller/index.d.ts",
      "default": "./dist/controller/index.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "default": "./dist/logging.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "node-pty": true,
    "node-hid": true,
    "esbuild": true
  },
  "scripts": {
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper ../node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "desktop:test": "cd desktop && swift test",
    "desktop:build": "zsh desktop/scripts/build-app.zsh",
    "capture": "tsx scripts/capture-hid.ts",
    "gen:controllers": "tsx scripts/gen-controller-table.ts && prettier --write CONTROLLERS.md",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test"
  },
  "dependencies": {
    "dualsense-ts": "^6.15.0",
    "node-hid": "^3.3.0",
    "node-pty": "^1.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
